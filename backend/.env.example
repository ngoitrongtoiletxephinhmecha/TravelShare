# ==========================================
# TRAVELSHARE BACKEND - ENVIRONMENT CONFIGURATION
# ==========================================

NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
FRONTEND_URL=http://localhost:5173
TIMEZONE=Asia/Ho_Chi_Minh
CURRENCY=VND

# --- DATABASE (MongoDB) ---
MONGODB_URI=mongodb://localhost:27017/travelshare?replicaSet=rs0&directConnection=true

# --- CACHE & REALTIME (Redis) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT AUTHENTICATION ---
JWT_ACCESS_SECRET=change-this-to-a-strong-access-secret-in-production-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-to-a-strong-refresh-secret-in-production-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost

# --- GEMINI AI (Phase 6 - AI Travel Assistant) ---
# Lấy API Key tại https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=60000
