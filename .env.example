# ==========================================
# TRAVELSHARE - ENVIRONMENT CONFIGURATION
# ==========================================

# --- APPLICATION ---
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
FRONTEND_URL=http://localhost:5173
TIMEZONE=Asia/Ho_Chi_Minh
CURRENCY=VND

# --- DATABASE (MongoDB) ---
MONGODB_URI=mongodb://localhost:27017/travelshare?replicaSet=rs0&directConnection=true

# --- CACHE & REALTIME (Redis) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT AUTHENTICATION ---
JWT_ACCESS_SECRET=change-this-to-a-strong-access-secret-in-production-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-to-a-strong-refresh-secret-in-production-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost

# --- GOOGLE OAUTH (Optional - Leave blank if not configured) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# --- MEDIA STORAGE (Cloudinary / S3 Compatible) ---
STORAGE_DRIVER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- GEMINI AI (Phase 6 - AI Travel Assistant) ---
# Lấy API Key tại https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-4-hydrogen
GEMINI_TIMEOUT_MS=60000

# --- FRONTEND (Vite) ---
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_SOCKET_URL=http://localhost:4000
VITE_APP_NAME=TravelShare
